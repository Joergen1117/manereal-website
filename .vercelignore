# Was Vercel NICHT ausliefern soll.
# Ausgeliefert werden nur: index.html, assets/, api/, vercel.json
#
# Ohne diese Liste wären interne Unterlagen über die Domain abrufbar,
# zum Beispiel manereal.at/PRODUCT.md oder /docs/AENDERUNGEN.md.

# Arbeitsunterlagen
CLAUDE.md
PRODUCT.md
content/
docs/

# Archiv: Erstentwurf, Rohmaterial, ausgemusterte Dateien (rund 80 MB).
# Darin liegt seit 02.10.2026 auch die Outreach-Auswertung samt
# Datenbankschema (archive/outreach-tracking/) -- ohne diese Zeile wäre
# sie über die Domain abrufbar und ihre Functions würden wieder gebaut.
archive/

# Kommandozeilenwerkzeuge -- werden nicht ausgeliefert.
scripts/

# Werkzeuge und Sitzungsdateien
.claude/
_tmp/
.gstack/
.playwright-mcp/
